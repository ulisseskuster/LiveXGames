# ==============================================================================
# LiveX Games - Configurações de Ambiente (.env)
# Copie este arquivo para .env e preencha conforme sua infraestrutura.
# ==============================================================================

# Porta do Servidor e Modo de Execução
PORT=3000
NODE_ENV=development

# Segredo de Assinatura JWT. Gere um valor único e aleatório (ex.: `openssl rand -hex 48`).
# Obrigatório em produção (o servidor recusa iniciar sem ele); se deixado em branco em
# desenvolvimento/teste, um segredo aleatório efêmero é gerado automaticamente a cada execução.
JWT_SECRET=

# ==============================================================================
# BANCO DE DADOS POSTGRESQL (100% Gratuito no Supabase ou Neon.tech)
# Exemplo Supabase: postgresql://postgres.xxxx:sua_senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Se não preenchido, o sistema roda com InMemoryStore (em memória RAM) para testes.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true exige validação estrita do certificado TLS do
# servidor (recomendado quando o provedor suportar); por padrão é relaxada (false) por
# compatibilidade com alguns poolers gerenciados.
# ==============================================================================
DATABASE_URL=
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Validação estrita do certificado TLS do banco (opcional, recomendado em produção).
# Cole aqui o certificado CA raiz do provedor, em PEM, incluindo as linhas BEGIN/END.
# No Supabase: Project Settings > Database > SSL Configuration > Download certificate.
# Quando preenchido, a validação estrita é ligada automaticamente (não precisa mexer
# em DATABASE_SSL_REJECT_UNAUTHORIZED). Se ficar vazio, a conexão continua funcionando
# com validação relaxada, como hoje.
DATABASE_SSL_CA=

# ==============================================================================
# WEBHOOKS DE PAGAMENTO OFICIAIS (LivePix & PixGG)
# Gere valores únicos e aleatórios e configure-os também no painel do LivePix e PixGG
# para validar as assinaturas HMAC SHA-256 dos webhooks. Obrigatórios em produção;
# se deixados em branco em desenvolvimento/teste, valores aleatórios efêmeros são
# gerados automaticamente a cada execução.
# ==============================================================================
LIVEPIX_WEBHOOK_SECRET=
PIXGG_WEBHOOK_SECRET=

# ==============================================================================
# ARMAZENAMENTO DE FOTOS EM NUVEM (100% Gratuito no Cloudinary - 25GB)
# Crie uma conta gratuita em https://cloudinary.com e copie sua CLOUDINARY_URL
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Se vazio, as fotos são mantidas localmente/base64 de forma transparente.
# ==============================================================================
CLOUDINARY_URL=

# ==============================================================================
# AUTENTICAÇÃO OFICIAL TWITCH (OAuth 2.0 & Helix Subscriptions API)
# Console Twitch: https://dev.twitch.tv/console
# ==============================================================================
TWITCH_CLIENT_ID=kd1unb4gahabc4rr63680b7axtcf6u
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://livexgames.onrender.com/api/auth/twitch/callback
TWITCH_AUTH_ENDPOINT=https://id.twitch.tv/oauth2/authorize
TWITCH_BROADCASTER_ID=

# ==============================================================================
# AUTENTICAÇÃO OFICIAL KICK (OAuth 2.1 + PKCE & Webhooks assinados com RSA)
# Painel Kick: https://kick.com/settings/developer
# ==============================================================================
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://livexgames.onrender.com/api/auth/kick/callback

# ==============================================================================
# CORS — ORIGENS PERMITIDAS PARA CHAMADAS CROSS-SITE DO NAVEGADOR
# Deixe em branco na maioria dos casos: o frontend é servido pelo mesmo serviço
# Express (mesma origem), então o navegador nem precisa de CORS para falar com a
# API. Só preencha se outro domínio (ex.: um painel administrativo à parte) também
# precisar chamar esta API diretamente do navegador. Aceita múltiplas origens
# separadas por vírgula. Em produção, sem isso preenchido, nenhuma origem
# cross-site é liberada (mais seguro); fora de produção, libera qualquer origem
# para facilitar o desenvolvimento local.
# Ex.: CORS_ORIGIN=https://livexgames.onrender.com,https://painel.exemplo.com
# ==============================================================================
CORS_ORIGIN=

# ==============================================================================
# CONTA ADMINISTRATIVA OFICIAL
# Sem ADMIN_PASSWORD definida, a conta administrativa NÃO é criada pelo seed —
# não existe mais senha padrão embutida no código (a que havia estava neste
# repositório público e era reescrita na conta a cada reinício do servidor).
# Esta variável é a fonte da verdade da senha: para rotacionar, troque o valor e
# reinicie. Gere um valor forte, ex.: `openssl rand -base64 24`.
# Alternativa sem plantar senha no banco: use ADMIN_USERNAMES abaixo.
# ==============================================================================
ADMIN_USERNAME=admin_livex
ADMIN_PASSWORD=

# ==============================================================================
# URL PÚBLICA DO SERVIÇO
# Usada para montar a URL de webhook que o streamer copia para o painel do
# gateway. Sem ela, o valor é derivado do cabeçalho Host da requisição, que é
# escrito pelo cliente e pode ser forjado. Defina em produção.
# Ex.: PUBLIC_BASE_URL=https://livexgames.onrender.com
# ==============================================================================
PUBLIC_BASE_URL=

# ==============================================================================
# ENVIO DE E-MAIL (SMTP)
#
# Necessário para "esqueci minha senha" e para a confirmação de cadastro. Sem
# SMTP_HOST nada é enviado: a mensagem e o link completo saem no log do
# servidor — suficiente para desenvolver e rodar os testes, inútil para o
# usuário final, que pede o link e não recebe nada.
#
# Depois de preencher, confira em dez segundos:
#     cd backend && npm run email:test seu@email.com
#
# VALORES POR PROVEDOR (planos gratuitos, conferidos em setembro/2026)
#
#   Brevo — 300 e-mails/dia, sem cartão, permanente. Melhor teto diário.
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_PORT=587
#     SMTP_USER=<o login SMTP do painel, algo como 91abc1@smtp-brevo.com>
#     SMTP_PASS=<a SMTP key do painel, NÃO a senha da sua conta>
#
#   Resend — 3.000/mês, mas no máximo 100/dia. Configuração mais rápida.
#     SMTP_HOST=smtp.resend.com
#     SMTP_PORT=587
#     SMTP_USER=resend          <- literalmente esta palavra
#     SMTP_PASS=<a API key>
#
#   Mailjet — 6.000/mês, sem teto diário apertado.
#     SMTP_HOST=in-v3.mailjet.com
#     SMTP_PORT=587
#     SMTP_USER=<API Key>
#     SMTP_PASS=<Secret Key>
#
# Em todos, o domínio do MAIL_FROM precisa estar verificado no painel do
# provedor (SPF e DKIM), senão a mensagem é recusada ou cai no spam.
# Porta 465 usa TLS direto; 587 negocia com STARTTLS e é a escolha usual.
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LiveX Games <nao-responda@seudominio.com>

# ==============================================================================
# PROMOÇÃO AUTOMÁTICA DE ADMINISTRADORES
# Usernames listados aqui (separados por vírgula) são promovidos para role 'admin'
# automaticamente no próximo login ou cadastro — é assim que se concede acesso ao
# painel de testes E2E (/tests.html) e às demais funções administrativas.
# Ex.: ADMIN_USERNAMES=ukc___,outro_admin
# ==============================================================================
ADMIN_USERNAMES=
